{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "startCommand": "python manage.py migrate && gunicorn emergency_system.wsgi:application --bind 0.0.0.0:$PORT --workers 2",
        "healthcheckPath": "/api/",
        "restartPolicyType": "ON_FAILURE"
    }
}